# ==============================================================================
# MEP QA/QC DASHBOARD ENVIRONMENT CONFIGURATION
# ==============================================================================

# Django Secret Key & Debug Mode
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# ==============================================================================
# CLOUDFLARE R2 OBJECT STORAGE (10GB PERPETUAL FREE TIER)
# Set USE_CLOUDFLARE_R2=True when hosting in production (Render, Railway, etc.)
# Leave False for local offline development (uses local media/ folder)
# ==============================================================================
USE_CLOUDFLARE_R2=False

# 1. Your Cloudflare Account ID (Found in Cloudflare Dashboard URL or R2 overview)
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# 2. Your R2 Bucket Name (e.g. mep-defects-media)
R2_BUCKET_NAME=mep-defects-media

# 3. R2 API Token Credentials (Created under R2 > Manage R2 API Tokens with Object Read & Write permission)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# 4. (Optional) Public Access Domain for direct CDN image loading
# In your R2 bucket settings > 'Settings' > 'Public Access', enable R2.dev subdomain or add a custom domain
# Example: pub-xxxxxxxxxxxxxxxxxxxx.r2.dev or media.yourdomain.com
R2_PUBLIC_DOMAIN=
